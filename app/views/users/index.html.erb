<div class="container">
  <div class="row">
    <div class="col-md-3">
      <%= render "users/info", user: @user %>

      <h2>New book</h2>
      <%= form_with model: @book, url: books_path do |f| %>
        <div class="form-group mb-3">
          <%= f.label :title %>
          <%= f.text_field :title, class: "form-control" %>
        </div>
        <div class="form-group mb-3">
          <%= f.label :body, "Opinion" %>
          <%= f.text_area :body, class: "form-control" %>
        </div>
        <%= f.submit "Create Book", class: "btn btn-success" %>
      <% end %>
    </div>

      <h2>Book detail</h2>
      <table class="table">
        <tr>
          <td>
            <% if book.user.profile_image.attached? %>
              <%= image_tag book.user.profile_image, size: "50x50" %><br>
            <% else %>
              <%= image_tag "no_image.jpg", size: "50x50" %><br>
            <% end %>
            <%= @book.user.name %>
          </td>
          <td><%= @book.title %></td>
          <td><%= @book.body %></td>
          <% if @book.user == current_user %>
            <td><%= link_to "Edit", edit_book_path(@book), class: "btn btn-sm btn-success" %></td>
            <td><%= link_to "Destroy", book_path(@book), data: { turbo_method: :delete, turbo_confirm: "本当に消しますか？" }, class: "btn btn-sm btn-danger" %></td>
          <% end %>
        </tr>
      </table>

<h2>Books</h2>
<table class="table">
  <thead>
    <tr><th></th><th>Title</th><th>Opinion</th></tr>
  </thead>
  <tbody>
    <% @books.each do |book| %>
      <tr>
        <td>
          <% if book.user.profile_image.attached? %>
            <%= image_tag book.user.profile_image, size: "50x50" %>
          <% else %>
            <%= image_tag "no_image.jpg", size: "50x50" %>
          <% end %>
        </td>
        <td><%= link_to book.title, book_path(book) %></td>
        <td><%= book.body %></td>
      </tr>
    <% end %>
  </tbody>
  </table>
  </div>
</div>