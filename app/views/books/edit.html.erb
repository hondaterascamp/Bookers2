<div class="container">
  <div class="row">
    <div class="col-md-6 mx-auto">
      <h2>Editing Book</h2>
      <%= form_with model: @book do |f| %>
        <div class="form-group mb-3">
          <%= f.label :title %>
          <%= f.text_field :title, class: "form-control" %>
        </div>
        <div class="form-group mb-3">
          <%= f.label :Opinion %>
          <%= f.text_area :opinion, class: "form-control" %>
        </div>
        <div>
        <%= f.submit "Update Book", class: "btn btn-success" %>
        </div>

        <%= link_to "Show", book_path(@book), class: "btn" %>
        <%= link_to "Back", books_path, class: "btn" %>

      <% end %>
    </div>
  </div>
</div>